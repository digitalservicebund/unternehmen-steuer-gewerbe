# Template for local development and testing only(!) — contains no real secrets.
# For anything beyond test values, load secrets at runtime from 1Password
# (or a similar secrets manager) and never commit them to git!
# Details for 1Password CLI: https://developer.1password.com/docs/cli/secrets-environment-variables/
#
# This file is not used in production!

# see https://docs.fitko.de/fit-connect/docs/getting-started/environments for details
FIT_CONNECT_OAUTH_TOKEN_URL="https://auth-testing.fit-connect.fitko.dev/token"
FIT_CONNECT_SUBMISSION_API_URL="https://test.fit-connect.fitko.dev/submission-api"
FIT_CONNECT_DESTINATION_API_URL="https://test.fit-connect.fitko.dev/destination-api"
FIT_CONNECT_ROUTING_API_URL="https://routing-api-testing.fit-connect.fitko.dev"

# see https://portal.auth-testing.fit-connect.fitko.dev/clients?type=SENDER
FIT_CONNECT_CLIENT_ID="op://v6dni5kwctu5b5sf2hzfs5jw5i/6jpon7pxrllnw6dzp3wjmylc6u/client-id"
FIT_CONNECT_CLIENT_SECRET="op://v6dni5kwctu5b5sf2hzfs5jw5i/6jpon7pxrllnw6dzp3wjmylc6u/client-secret"

FIT_CONNECT_PUBLIC_KEY_ENCRYPTION_JWK="op://v6dni5kwctu5b5sf2hzfs5jw5i/6jpon7pxrllnw6dzp3wjmylc6u/public-key"
FIT_CONNECT_PRIVATE_KEY_DECRYPTION_JWK="op://v6dni5kwctu5b5sf2hzfs5jw5i/6jpon7pxrllnw6dzp3wjmylc6u/private-key"

# see https://www.elster.de/elsterweb/entwickler/antrag-hersteller-id/form
ERIC_HERSTELLERID="op://v6dni5kwctu5b5sf2hzfs5jw5i/l2tz7wl4ssk5iy2ovlbyz4yrk4/hersteller-id"
ERIC_CERTIFICATE_BASE64="op://v6dni5kwctu5b5sf2hzfs5jw5i/l2tz7wl4ssk5iy2ovlbyz4yrk4/certificate-base64"
ERIC_CERTIFICATE_PIN="op://v6dni5kwctu5b5sf2hzfs5jw5i/l2tz7wl4ssk5iy2ovlbyz4yrk4/certificate-pin"

# AKDB OK.KOMM
AKDB_BASE_URL="op://v6dni5kwctu5b5sf2hzfs5jw5i/6j4n7vpvsgmd37dgqy4v7ulkxa/url"
AKDB_USERNAME="op://v6dni5kwctu5b5sf2hzfs5jw5i/6j4n7vpvsgmd37dgqy4v7ulkxa/username"
AKDB_PASSWORD="op://v6dni5kwctu5b5sf2hzfs5jw5i/6j4n7vpvsgmd37dgqy4v7ulkxa/api-secret"

# Static destinations for testing
#
# Both variables let us override the destination the Gewerbeanmeldung is sent to,
# so we can test the actual submission against a fixed test authority instead of
# the one the routing lookup resolves from the address.
# If TEST_FIT_CONNECT_DESTINATION_ID_OVERRIDE is set, we always submit via
# FIT-Connect to that Zustellpunkt; TEST_OSCI_ARS_OVERRIDE replaces the resolved
# ARS in the OSCI submission.
#
# UUID of the FIT-Connect destination (Zustellpunkt):
# see https://docs.fitko.de/fit-connect/docs/receiving/destination/#zustellpunktverwaltung
TEST_FIT_CONNECT_DESTINATION_ID_OVERRIDE="fa63ede0-0ef6-4ca6-abd2-6bd16729ddc1"
# The Testinstance from AKDB only supports Messages to the ARS 090000000099
TEST_OSCI_ARS_OVERRIDE="090000000099"