# Template for local development and testing only(!) — contains no real secrets.
# For anything beyond test values, load secrets at runtime from 1Password
# (or a similar secrets manager) and never commit them to git!
# Details for 1Password CLI: https://developer.1password.com/docs/cli/secrets-environment-variables/
#
# This file is not used in production!

# see https://docs.fitko.de/fit-connect/docs/getting-started/environments for details
FIT_CONNECT_ENV="test"

# see https://portal.auth-testing.fit-connect.fitko.dev/clients?type=SENDER
FIT_CONNECT_CLIENT_ID="some-uuid"
FIT_CONNECT_CLIENT_SECRET="secret"

# see https://portal.auth-testing.fit-connect.fitko.dev/destinations for details
FIT_CONNECT_DESTINATION_ID="some-uuid"

FIT_CONNECT_PUBLIC_KEY_ENCRYPTION_JWK='{"some":"jwk-json"}'
FIT_CONNECT_PRIVATE_KEY_DECRYPTION_JWK='{"some":"jwk-json"}'

# see https://www.elster.de/elsterweb/entwickler/antrag-hersteller-id/form
ERIC_HERSTELLERID='74931'
ERIC_CERTIFICATE_BASE64='base64-encoded-certificate'
ERIC_CERTIFICATE_PIN='certificate-pin'

# fetching private code
NODE_AUTH_TOKEN="token"
