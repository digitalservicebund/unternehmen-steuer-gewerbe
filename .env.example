# Template for local development and testing only(!) — contains no real secrets.
# For anything beyond test values, load secrets at runtime from 1Password
# (or a similar secrets manager) and never commit them to git!
# Details for 1Password CLI: https://developer.1password.com/docs/cli/secrets-environment-variables/
#
# This file is not used in production!

# see https://docs.fitko.de/fit-connect/docs/getting-started/environments
FIT_CONNECT_OAUTH_TOKEN_URL="https://auth-testing.fit-connect.fitko.dev/token"
FIT_CONNECT_SUBMISSION_API_URL="https://test.fit-connect.fitko.dev/submission-api"
FIT_CONNECT_DESTINATION_API_URL="https://test.fit-connect.fitko.dev/destination-api"
FIT_CONNECT_ROUTING_API_URL="https://routing-api-testing.fit-connect.fitko.dev"

# OAuth2 Client-ID and Client-Secret from the FIT-Connect Self-Service-Portal:
# see https://docs.fitko.de/fit-connect/docs/receiving/destination/#zustellpunktverwaltung
FIT_CONNECT_CLIENT_ID="some-uuid"
FIT_CONNECT_CLIENT_SECRET="secret"

# UUID of the FIT-Connect destination (Zustellpunkt):
# see https://docs.fitko.de/fit-connect/docs/receiving/destination/#zustellpunktverwaltung
FIT_CONNECT_DESTINATION_ID="some-uuid"

# Public JWK for FIT-Connect encryption, as JSON string:
# see https://docs.fitko.de/fit-connect/docs/organisation-tasks/jwks-erzeugen#jwk_erzeugen
FIT_CONNECT_PUBLIC_KEY_ENCRYPTION_JWK='{"some":"jwk-json"}'
# Corresponding private JWK for FIT-Connect decryption, same source as above
FIT_CONNECT_PRIVATE_KEY_DECRYPTION_JWK='{"some":"jwk-json"}'

# ESTER User ID + authentication
# see https://www.elster.de/elsterweb/entwickler/antrag-hersteller-id/form
ERIC_HERSTELLERID='74931'
ERIC_CERTIFICATE_BASE64='base64-encoded-certificate'
ERIC_CERTIFICATE_PIN='certificate-pin'

# AKDB OK.KOMM
AKDB_BASE_URL="https://soaptest.akdb.de/okkomm"
AKDB_USERNAME="ServicegesellschaftBund"
AKDB_PASSWORD="your-okkomm-password"

OSCI_ARS_OVERRIDE="090000000099"

# fetching private code
NODE_AUTH_TOKEN="token"
