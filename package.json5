{
  name: "unternehmen-steuer-gewerbe",
  version: "1.0.0",
  description: "",
  keywords: [],
  license: "",
  author: "",
  type: "module",
  scripts: {
    // Compile TypeScript to ./dist/
    build: "tsc && mkdir -p dist/src && cp -r src/resources dist/src/resources",
    // Build app and docker image
    "build:image": "pnpm build; docker build . --tag unternehmen-steuer-gewerbe",
    // Check format, fail on error (used in CI)
    format: "oxfmt --check",
    // Check format, fix if possible (used in pre-commit GitHook)
    "format:fix": "oxfmt",
    // Lint, fail on error (used in CI)
    lint: "oxlint",
    // Lint, fix if possible (used in pre-commit GitHook)
    "lint:fix": "oxlint --fix",
    // Start API locally via ts-node (no building involved)
    start: "op run --env-file .env -- ts-node src/index.ts",
    // Start API via docker (built via "npm run build:image")
    "start:image": "docker run -p 3000:3000 unternehmen-steuer-gewerbe",
    // Start API locally via ts-node (no building involved), restart on changes to files of type TS, JS, JSON, JSON5, YAML, MD
    "start:watch": "op run --env-file .env -- nodemon --watch . --ignore dist --ext ts,json,json5,yml,md --exec pnpm run start",
    // Run tests once
    test: "op run --env-file .env -- vitest run",
    // Run tests once, report coverage on console and in ./coverage. Format is HTML and lconv (in pipeline, lconv is consumed by SonarCloud)
    "test:coverage": "op run --env-file .env -- vitest run --coverage",
    // Run tests once, report coverage on console and in ./coverage. Format is HTML and lconv (in pipeline, lconv is consumed by SonarCloud)
    "test:ci:coverage": "vitest run --coverage",
    // Run tests, restart on code changes
    "test:watch": "op run --env-file .env -- vitest",
  },
  dependencies: {
    "@hono/node-server": "^2.0.0",
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    dotenv: "^17.4.2",
    "ffi-napi": "^4.0.3",
    hono: "^4.12.15",
    "hono-openapi": "^1.3.0",
    jose: "^6.2.2",
    "ref-napi": "^3.0.3",
    "saxonjs-he": "3.0.0-beta2",
    vite: "8.0.10",
    "xmllint-wasm": "^5.2.0",
    zod: "^4.3.6",
  },
  devDependencies: {
    "@types/ffi-napi": "^4.0.10",
    "@types/node": "^25.6.0",
    "@types/ref-napi": "^3.0.12",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.1.5",
    "fast-xml-parser": "^5.7.1",
    nodemon: "^3.1.14",
    oxfmt: "^0.46.0",
    oxlint: "^1.61.0",
    "ts-node": "^10.9.2",
    typescript: "^6.0.3",
    vitest: "^4.1.5",
    "xslt3-he": "3.0.0-beta2",
  },
  packageManager: "pnpm@10.33.2",
}
