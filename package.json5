{
  name: "unternehmen-steuer-gewerbe",
  version: "1.0.0",
  description: "",
  keywords: [],
  license: "",
  author: "",
  type: "module",
  scripts: {
    // Build and bundle to./dist/bundle.js
    build: "rolldown -c rolldown.config.js",
    // Build app and docker image
    "build:image": "pnpm build; docker build . --tag unternehmen-steuer-gewerbe",
    // Check format, fail on error (used in CI)
    format: "oxfmt --check",
    // Check format, fix if possible (used in pre-commit GitHook)
    "format:fix": "oxfmt",
    // Lint, fail on error (used in CI)
    lint: "oxlint",
    // Lint, fix if possible (used in pre-commit GitHook)
    "lint:fix": "oxlint --fix",
    // Start API locally via ts-node (no building involved)
    start: "ts-node src/index.ts",
    // Start API locally via ts-node (no building involved), restart on changes to files of type TS, JS, JSON, JSON5, YAML, MD
    "start:watch": "nodemon --watch . --ext ts,json,json5,yml,md --exec pnpm run start",
    // Run tests once
    test: "vitest run",
    // Run tests once, report coverage on console and in ./coverage. Format is HTML and lconv (in pipeline, lconv is consumed by SonarCloud)
    "test:coverage": "vitest run --coverage",
    // Run tests, restart on code changes
    "test:watch": "vitest",
  },
  dependencies: {
    "@types/express": "^5.0.6",
    dotenv: "^17.3.1",
    express: "^5.2.1",
    jose: "^6.2.2",
    helmet: "^8.1.0",
  },
  devDependencies: {
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.1.1",
    nodemon: "^3.1.14",
    oxfmt: "^0.42.0",
    oxlint: "^1.58.0",
    rolldown: "1.0.0-rc.13",
    supertest: "^7.2.2",
    "ts-node": "^10.9.2",
    typescript: "^6.0.2",
    vitest: "^4.1.2",
  },
  packageManager: "pnpm@10.33.0",
}
