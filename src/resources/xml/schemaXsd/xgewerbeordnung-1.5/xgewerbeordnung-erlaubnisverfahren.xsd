         <xs:extension base="bn-g2g:Nachricht.G2GType">
            <xs:sequence>
               <xs:element name="uuid" type="bdt:UUID">
                  <xs:annotation>
                     <xs:documentation>Eine vom Online-Dienst vergebene eindeutige Kennung des Antragsvorgangs.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="zeitstempelAntragsstellung" type="xs:dateTime">
                  <xs:annotation>
                     <xs:documentation>Der vom Online-Dienst festgestellte Zeitpunkt, an welchem der Antrag erfolgreich durch den Nutzer gestellt wurde.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element ref="antr:antragsteller.id">
                  <xs:annotation>
                     <xs:documentation>ID-Verweis innerhalb des jeweiligen Kontextes auf ein Element erl:natuerlichePerson oder erl:juristischePerson in der Rolle Antragsteller.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element ref="antr:handelndePerson.id">
                  <xs:annotation>
                     <xs:documentation>ID-Verweis innerhalb des jeweiligen Kontextes auf ein Element erl:natuerlichePerson in der Rolle Handelnde Person.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element ref="bk:handelndePerson.vertrauensniveauIdentifikation">
                  <xs:annotation>
                     <xs:documentation>Das Vertrauensniveau gemäß welchem die Identität der handelnden natürlichen Person vom Online-Dienst festgestellt wurde.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element ref="antr:ansprechpartner.id" minOccurs="0">
                  <xs:annotation>
                     <xs:documentation>Angabe des Ansprechpartners als ID-Querverweis innerhalb des jeweiligen Kontextes (Nachricht, Datensatz) auf ein Element np:natuerlichePerson (oder auf ein entsprechendes abgeleitetes Element).</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element ref="bk:nachweisdokument.onlinedienst"
                           minOccurs="0"
                           maxOccurs="unbounded">
                  <xs:annotation>
                     <xs:documentation>Vom Online-Dienst selbst erstellte Nachweisdokumente zur Ablage in der Akte der fachlich zuständigen Stelle. Beispiel: Die Willenserklärung eines oder der Antragstellenden "im Original".</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element ref="bk:nachweisdokument.upload"
                           minOccurs="0"
                           maxOccurs="unbounded">
                  <xs:annotation>
                     <xs:documentation>Vom Anwender hochgeladene Nachweisdokumente (hochgeladene Fotos, Scans, etc.).</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="freitext" minOccurs="0" type="bdt:String.DIN91379.C">
                  <xs:annotation>
                     <xs:documentation>Soweit im Antrag Freitextfelder vorgesehen sind, können sie mit diesem Element übermittelt werden.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="umfangBeantragteZulassung"
                           maxOccurs="unbounded"
                           type="erl:Code.Erlaubnisarten">
                  <xs:annotation>
                     <xs:documentation>Angabe zur Erlaubnis, die beantragt wird.</xs:documentation>
                  </xs:annotation>
               </xs:element>
               <xs:element name="referenzierteSubjekte"
                           maxOccurs="unbounded"
                           type="erl:ReferenzierteSubjekte">
                  <xs:annotation>
                     <xs:documentation>Innerhalb des Erlaubnisantrags über ID referenzierte Subjekte.</xs:documentation>
                  </xs:annotation>
               </xs:element>
            </xs:sequence>
         </xs:extension>
      </xs:complexContent>
   </xs:complexType>
   <xs:complexType name="ReferenzierteSubjekte">
      <xs:sequence>
         <xs:element ref="erl:natuerlichePerson" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation>Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Geburt und Anschrift mit spezifischeren Datentypen. Fachspezifische Angaben ergänzt. Hinweis: Die Angabe nichtVorhanden ist nur dann zulässig, wenn der jeweilige Namensbestandteil zu Recht nicht vorhanden ist.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element ref="erl:juristischePerson" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation>Unter juristischen Personen werden sowohl die Körperschaften des Privatrechts (Gesellschaft mit beschränkter Haftung, Aktiengesellschaft, Kommanditgesellschaft auf Aktien, eingetragener Verein, Genossenschaft) als auch öffentlich-rechtliche Körperschaften (Gebietskörperschaften, Selbstverwaltungskörperschaften, sonstige Körperschaften des öffentlichen Rechts) erfasst.Die konkrete Rechtsform der juristischen Person kann mittels einer Codeliste angegeben werden. Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Zustellanschrift mit spezifischerem Datentyp. Fachspezifische Angaben ergänzt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element ref="erl:rechtsfaehigePersonengesellschaft"
                     minOccurs="0"
                     maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation>Die rechtsfähige Personengesellschaft im Kontext von XGewerbeordnung umfasst sowohl die rechtsfähige Gesellschaft des Bürgerlichen Rechts (GbR), als auch Personenhandelsgesellschaften wie die Offene Handelsgesellschaft (oHG), die Kommanditgesellschaft (KG) und die Kapitalgesellschaft amp Co. KG. Entsprechend sind rechtsfähige Personengesellschaften nach ausländischem und supranationalem Recht zu berücksichtigen.Die konkrete Rechtsform der rechtsfähigen Personengesellschaft kann mittels einer Codeliste angegeben werden. Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Einschränkung: Keine Partnerschaftsgesellschaften. Zustellanschrift mit spezifischerem Datentyp. Fachspezifische Angaben ergänzt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element ref="erl:sonstigePersonenvereinigung"
                     minOccurs="0"
                     maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation>Hierunter werden alle Personenvereinigungen gefasst, die weder unter juristische Personen noch unter rechtsfähige Personengesellschaften fallen. Die sonstigen Personenvereinigungen (z. B. die Erbengemeinschaft) werden in der Regel nicht wirtschaftlich tätig.Die konkrete Rechtsform der sonstigen Personenvereinigung kann mittels einer Codeliste angegeben werden. Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Zustellanschrift mit spezifischerem Datentyp. Fachspezifische Angaben ergänzt.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="Zuverlaessigkeit.AngabenDetail">
      <xs:sequence>
         <xs:element name="angabe" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Gibt an, wie die jeweilige Angabe gemacht wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="angabeFuer.id" minOccurs="0" type="bdt:IDType">
            <xs:annotation>
               <xs:documentation>Referenz auf das Subjekt, auf bzw. gegen das sich die Angabe richtet.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="behoerde" minOccurs="0" type="bdt:String.DIN91379.C">
            <xs:annotation>
               <xs:documentation>Angabe der Staatsanwaltschaft, des Gerichts oder der Behörde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="aktenzeichen" minOccurs="0" type="bdt:String.DIN91379.C">
            <xs:annotation>
               <xs:documentation>Angabe des Aktenzeichens.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="angabenNichtBekannt"
                     minOccurs="0"
                     default="true"
                     type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Gibt an, ob die Angabe(n) nicht bekannt ist/sind.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="Zuverlaessigkeit.Verfahren">
      <xs:annotation>
         <xs:documentation>In diesem Typ werden Detailangaben zu laufenden oder abgeschlossenen Verfahren zusammengefasst.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="angabe" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Angabe, ob das jeweilige Verfahren vorliegt.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="verfahrenGegen" minOccurs="0" maxOccurs="unbounded">
            <xs:annotation>
               <xs:documentation>Angaben zur Person/Gesellschaft und dem gegen sie vorliegenden Verfahren.</xs:documentation>
            </xs:annotation>
            <xs:complexType>
               <xs:sequence>
                  <xs:element name="verfahrenGegen.id" minOccurs="0" type="bdt:IDType">
                     <xs:annotation>
                        <xs:documentation>Referenz auf das Subjekt, gegen das sich das angegebene Verfahren richtet.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="behoerde" minOccurs="0" type="bdt:String.DIN91379.C">
                     <xs:annotation>
                        <xs:documentation>Angabe der Staatsanwaltschaft, des Gerichts oder der Behörde, bei dem das Verfahren anhängig ist oder war.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="aktenzeichen" minOccurs="0" type="bdt:String.DIN91379.C">
                     <xs:annotation>
                        <xs:documentation>Angabe des Aktenzeichens des Verfahrens.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:complexType>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:complexType name="Zuverlaessigkeit.Vermoegensverhaeltnisse">
      <xs:annotation>
         <xs:documentation>In diesem Typ werden Detailangaben zu Vermögensverhältnissen zusammengefasst.</xs:documentation>
      </xs:annotation>
      <xs:sequence>
         <xs:element name="angabe" type="xs:boolean">
            <xs:annotation>
               <xs:documentation>Gibt an, wie die jeweilige Angabe gemacht wurde.</xs:documentation>
            </xs:annotation>
         </xs:element>
         <xs:element name="angabeFuer.id"
                     minOccurs="0"
                     maxOccurs="unbounded"
                     type="bdt:IDType">
            <xs:annotation>
               <xs:documentation>Referenz auf das Subjekt, für das die Angabe gemacht wird.</xs:documentation>
            </xs:annotation>
         </xs:element>
      </xs:sequence>
   </xs:complexType>
   <xs:element name="angabenAuftraggeberErlaubnisbefreiung">
      <xs:annotation>
         <xs:documentation>Angaben zum Auftraggeber innerhalb eines Antrags auf Erlaubnisbefreiung.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="nameAuftraggeber" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Name des Auftraggebers in einem Erlaubnisbefreiungsverfahren.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:anschrift" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Detailliertere Struktur für die Strassenanschrift. Detailliertere Struktur für die Auslandsanschriften. Keine Postfachanschrift.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="registrierungsnummer"
                        minOccurs="0"
                        type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe der Registrierungsnummer (bei Versicherungsvermittlern).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="baFinId" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe der BaFin-ID (bei Versicherungsunternehmen).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="nameKontaktperson" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Name der Kontaktperson beim angegebenen Auftraggeber.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="angabenParagraph1VersVermV">
      <xs:annotation>
         <xs:documentation>Angaben nach § 1 VersVermV.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="erl:beteiligtePersonVersVermV"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu der jeweiligen beteiligten natürlichen oder juristischen Person.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="nameVerbindung"
                        minOccurs="0"
                        maxOccurs="unbounded"
                        type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Verbindungen nach § 7 Nr. 7 VAG. Bei einer verbundenen natürlichen Person sind hier Vornamen und Familienname oder der eingetragene Name der Person zu nennen. Bei einer verbundenen juristischen Person ist hier der eingetragene Name anzugeben.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ausschlussBeeintraechtigungUeberwachung"
                        type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe der Tatsachen, die ausschließen, dass Beteiligungen oder enge Verbindungen nach § 7 Nr. 7 VAG die Überwachung durch die zuständige Industrie- und Handelskammer beeinträchtigen.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="angabenSpielgeraeteSpiele">
      <xs:annotation>
         <xs:documentation>Angaben zu aufgestellten Spielgeräten (§ 33c GewO) oder durchgeführten Spielen (§ 33d GewO).</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="artSpielgeraet" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Art des Geräts oder des Spiels.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="anzahlSpielgeraete" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Anzahl der Geräte oder des Spiels</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="angabenWeitereBeruflicheTaetigkeit">
      <xs:annotation>
         <xs:documentation>Angaben zur Ausübung einer weiteren beruflichen Tätigkeit einer im Rahmen der Zuverlässigkeitsprüfung relevanten natürlichen Person als Geschäftsführer einer GmbH, als phG einer OHG oder KG, oder als Inhaber eines Einzelunternehmens in den letzten 5 Jahren.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="beruflichTaetiger.id" type="bdt:IDType">
               <xs:annotation>
                  <xs:documentation>Referenz auf das Subjekt, das eine weitere berufliche Tätigkeit ausübt oder ausgeübt hat.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="firmenname" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Name der Firma, bei der die angegebene Tätigkeit ausgeübt wird oder wurde.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="aufenthaltstitel">
      <xs:annotation>
         <xs:documentation>Angaben zur Aufenthaltsgenehmigung bei Staatsangehörigkeit eines Drittstaats / eines Nicht-EU-Landes</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="status" type="bk:Code.Status">
               <xs:annotation>
                  <xs:documentation>Angabe des Status des Aufenthaltstitels</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ausgestelltAm" minOccurs="0" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Ausstellungsdatum des Aufenthaltstitels</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ausgestelltVonName"
                        minOccurs="0"
                        type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Name der den Aufenthaltstitel ausstellenden Behörde</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="aufstellortSpielgeraet">
      <xs:annotation>
         <xs:documentation>Angaben zum Aufstellort eines Spielgeräts mit Gewinnmöglichkeit.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="nameInhaber" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe des Namens des Inhabers.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="nameBetrieb" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe des Namens des Betriebs.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:anschrift" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Adresse des Aufstellortes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="artAufstellort" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe der Art des Aufstellortes.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="auslandsniederlassung">
      <xs:annotation>
         <xs:documentation>In diesem Typ werden Angaben der Geschäftsanschrift einer Zweigniederlassung oder ständigen Präsenz außerhalb Deutschlands in einem EU- bzw. EWR-Staat zusammengefasst.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="adr:staat">
               <xs:annotation>
                  <xs:documentation>Angabe des EU- bzw. EWR-Staats, in dem eine Zweigniederlassung oder ständige Präsenz beabsichtigt wird oder besteht.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="geschaeftsanschrift">
               <xs:annotation>
                  <xs:documentation>Angabe der Geschäftsanschrift einer Zweigniederlassung oder ständigen Präsenz außerhalb Deutschlands in einem EU- bzw. EWR-Staat.</xs:documentation>
               </xs:annotation>
               <xs:complexType>
                  <xs:choice>
                     <xs:element name="anschriftAuslandFreitext" type="bdt:String.DIN91379.C"/>
                     <xs:element ref="bk:anschriftAusland">
                        <xs:annotation>
                           <xs:documentation>Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Codierung des Staates über die Codeliste Destatis Staatsgebiete, nicht Destatis Staaten. Hausnummer differenziert (von, bis). Straßenschlüssel ergänzt. Ortsteil ergänzt.</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                  </xs:choice>
               </xs:complexType>
            </xs:element>
            <xs:element name="gesetzlicherVertreterAusland"
                        maxOccurs="unbounded"
                        type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Name (Vornamen und Familienname) der natürlichen Person, die die gesetzliche Vertretung in der Niederlassung bzw. ständigen Präsenz außerhalb Deutschlands in einem EU- bzw. EWR-Staat wahrnimmt.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="bZRAuskunft">
      <xs:annotation>
         <xs:documentation>Angaben zum Status einer bzw. mehrerer Auskünfte aus dem Bundeszentralregister.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:choice>
            <xs:element name="zusammengefasst">
               <xs:annotation>
                  <xs:documentation>Angaben, falls die erforderlichen BZR-Auskünfte zusammengefasst beantragt wurden oder die Beantragung zusammengefasst nachgeholt werden soll.</xs:documentation>
               </xs:annotation>
               <xs:complexType>
                  <xs:choice>
                     <xs:element name="datumBeantragungAuskunftBZR" minOccurs="0" type="xs:date">
                        <xs:annotation>
                           <xs:documentation>Datum der Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O).</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                     <xs:element name="datumGeplanteBeantragungAuskunftBZR"
                                 minOccurs="0"
                                 type="xs:date">
                        <xs:annotation>
                           <xs:documentation>Datum der geplanten Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O).</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                     <xs:element name="nachholungBeantragungAuskunftBZR"
                                 minOccurs="0"
                                 fixed="true"
                                 type="xs:boolean">
                        <xs:annotation>
                           <xs:documentation>Angabe, ob die Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O) nachgeholt wird.</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                  </xs:choice>
               </xs:complexType>
            </xs:element>
            <xs:element name="detail" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zur einzelnen Aufschlüsselung der Angaben zu den erforderlichen BZR-Auskünften.</xs:documentation>
               </xs:annotation>
               <xs:complexType>
                  <xs:sequence>
                     <xs:element name="beantragtFuer.id" type="bdt:IDType">
                        <xs:annotation>
                           <xs:documentation>Angabe der Person, auf welche sich die Beantragung bezieht.</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                     <xs:element name="antragsstatus">
                        <xs:annotation>
                           <xs:documentation>Angaben zum Antragsstatus.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                           <xs:choice>
                              <xs:element name="datumBeantragungAuskunftBZR" minOccurs="0" type="xs:date">
                                 <xs:annotation>
                                    <xs:documentation>Datum der Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O).</xs:documentation>
                                 </xs:annotation>
                              </xs:element>
                              <xs:element name="datumGeplanteBeantragungAuskunftBZR"
                                          minOccurs="0"
                                          type="xs:date">
                                 <xs:annotation>
                                    <xs:documentation>Datum der geplanten Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O).</xs:documentation>
                                 </xs:annotation>
                              </xs:element>
                              <xs:element name="nachholungBeantragungAuskunftBZR"
                                          minOccurs="0"
                                          fixed="true"
                                          type="xs:boolean">
                                 <xs:annotation>
                                    <xs:documentation>Angabe, ob die Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O) nachgeholt wird.</xs:documentation>
                                 </xs:annotation>
                              </xs:element>
                           </xs:choice>
                        </xs:complexType>
                     </xs:element>
                  </xs:sequence>
               </xs:complexType>
            </xs:element>
         </xs:choice>
      </xs:complexType>
   </xs:element>
   <xs:element name="beteiligtePersonVersVermV">
      <xs:annotation>
         <xs:documentation>Angaben gemäß § 1 VersVermV.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="nameBeteiligtePerson" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Bei einer beteiligten natürlichen Person sind hier Vornamen und Familienname oder der eingetragene Name der Person zu nennen. Bei einer beteiligten juristischen Person sind hier der eingetragene Name anzugeben.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="beteiligungStimmrechte" type="xs:integer">
               <xs:annotation>
                  <xs:documentation>Der jeweilige Stimmanteil am Kapital der angegebenen beteiligten Person in Prozent.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="betriebsstaette">
      <xs:annotation>
         <xs:documentation>Angabe zur bestehenden oder geplanten Hauptniederlassung.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="wt:artBetriebsstaette" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Nähere Bestimmung der Art der Betriebsstätte. Die möglichen Ausprägungen dieses Attributes sind durch die Codeliste Art einer Niederlassung (urn: xoev-de:xunternehmen:codeliste:artniederlassung) im XRepository bestimmt.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:anschrift" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Detailliertere Struktur für die Strassenanschrift. Detailliertere Struktur für die Auslandsanschriften. Keine Postfachanschrift.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="kom:kommunikation" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Telefon, Telefax, Email-Adresse und/oder Webseite.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="bisherigeTaetigkeiten">
      <xs:annotation>
         <xs:documentation>Angaben zu bisherigen Tätigkeiten mit gewerberechtlicher Erlaubnis.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="besitzGewerberechtlicheErlaubnis" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Angabe, dass der Antragstellende im Besitz einer gewerberechlichen Erlaubnis ist oder war.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="aktenzeichen" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe des Aktenzeichens des Verfahrens.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="behoerde" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Behörde, die die Erlaubnis ausgestellt hat.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="untersagungGewerbe" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Angabe zur Untersagung einer gewerberechtlichen Erlaubnis oder selbstständigen Gewerbetätigkeit.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="eintragung">
      <xs:annotation>
         <xs:documentation>Dieses Kerndatenobjekt fasst die Daten, mit welchen die Eintragung eines wirtschaftlich Tätigen bzw. eines Gewerbebetriebs in ein Register (Handels-, Genossenschafts- oder Vereinsregister) oder in ein Verzeichnis (Stiftungsverzeichnis) identifiziert werden kann.Die Eintragung kann auch in ein Register oder Verzeichnis erfolgen, welches in einem anderen Staat geführt wird.Zwischen Rechtsform und Eintragung besteht ein Zusammenhang. Welche Eintragungsarten (Handelsregister A, Handelsregister B, Genossenschaftsregister, Vereinsregister, Register im Ausland, Kraft Gesetz) für welche Rechtsformen zulässig sein können, wird als Information in der Codeliste der Rechtsformen mitgeführt. Das Objekt ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Semantisch konkretisiert auf Gewerbebetriebe als Art der wirtschaftlichen Tätigkeit Keine Eintragung im Partnerschaftsregister zulässig Eintragungsdatum als optionale Angabe Das Element staat wurde nicht aus dem Basismodul übernommen, da dort Code und nicht Freitext vorgesehen ist.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="eintr:artEintragung">
               <xs:annotation>
                  <xs:documentation>Angabe der Art des Registers, in welchem der wirtschaftlich Tätige bzw. die wirtschaftliche Tätigkeit (z. B. Zweigniederlassung) geführt wird.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="eintr:registergericht.code" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Schlüssel des Registergerichts, in dessen Handels-, Genossenschafts-, Partnerschafts- oder Vereinsregister, in welchem der wirtschaftlich Tätige bzw. die wirtschaftliche Tätigkeit (z. B. Zweigniederlassung) geführt wird.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="eintr:stiftungsverzeichnis" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Bei Einträgen im Stiftungsverzeichnis: Angabe des Bundeslandes bzw. der Behörde, in dessen oder deren Stiftungsverzeichnis der Eintrag geführt wird.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="adr:ort" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Bei Einträgen im Ausland: Angabe des Ortes der registerführenden Stelle.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="staat" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Bei Einträgen im Ausland: Angabe des Staates der registerführenden Stelle.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="eintr:eintragungsnummer">
               <xs:annotation>
                  <xs:documentation>Nummer der Eintragung im jeweiligen Register</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="dat:datum" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Datum der Eintragung</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="fruehereHauptniederlassung">
      <xs:annotation>
         <xs:documentation>Angaben zu einer früheren Hauptniederlassung in den letzten fünf Jahren.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="adr:anschrift">
               <xs:annotation>
                  <xs:documentation>Angaben für die Adressierung. Eine Anschrift ist entweder eine Inlands- oder ein Auslandsanschrift.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="von" type="dat:Datum.MitTeilbekanntUndUnbekanntType">
               <xs:annotation>
                  <xs:documentation>Datum der Anmeldung einer früheren Hauptniederlassung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="bis" type="dat:Datum.MitTeilbekanntUndUnbekanntType">
               <xs:annotation>
                  <xs:documentation>Datum der Abmeldung einer früheren Hauptniederlassung.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="fruehererHauptwohnsitz">
      <xs:annotation>
         <xs:documentation>Angabe der weiteren Hauptwohnsitze, an denen die Person in den letzten 5 Jahren gemeldet war.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="adr:anschrift">
               <xs:annotation>
                  <xs:documentation>Angaben für die Adressierung. Eine Anschrift ist entweder eine Inlands- oder ein Auslandsanschrift.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="von" type="dat:Datum.MitTeilbekanntUndUnbekanntType">
               <xs:annotation>
                  <xs:documentation>Datum der Anmeldung eines früheren Hauptwohnsitzes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="bis" type="dat:Datum.MitTeilbekanntUndUnbekanntType">
               <xs:annotation>
                  <xs:documentation>Datum der Abmeldung eines früheren Hauptwohnsitzes.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="gZRAuskunft">
      <xs:annotation>
         <xs:documentation>Angaben zum Status einer bzw. mehrerer Auskünfte aus dem Gewerbezentralregister.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:choice>
            <xs:element name="zusammengefasst">
               <xs:annotation>
                  <xs:documentation>Angaben, falls die erforderlichen GZR-Auskünfte zusammengefasst beantragt wurden oder die Beantragung zusammengefasst nachgeholt werden soll.</xs:documentation>
               </xs:annotation>
               <xs:complexType>
                  <xs:choice>
                     <xs:element name="datumBeantragungAuskunftGZR" minOccurs="0" type="xs:date">
                        <xs:annotation>
                           <xs:documentation>Datum der Beantragung einer Auskunft aus dem Gewerbezentralregister zur Vorlage bei einer Behörde (Belegart 9).</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                     <xs:element name="datumGeplanteBeantragungAuskunftGZR"
                                 minOccurs="0"
                                 type="xs:date">
                        <xs:annotation>
                           <xs:documentation>Datum der geplanten Beantragung einer Auskunft aus dem Gewerbezentralregister zur Vorlage bei einer Behörde (Belegart 9).</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                     <xs:element name="nachholungBeantragungAuskunftGZR"
                                 minOccurs="0"
                                 fixed="true"
                                 type="xs:boolean">
                        <xs:annotation>
                           <xs:documentation>Angabe, ob die Beantragung einer Auskunft aus dem Gewerbezentralregister zur Vorlage bei einer Behörde (Belegart 9) nachgeholt wird.</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                  </xs:choice>
               </xs:complexType>
            </xs:element>
            <xs:element name="detail" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zur einzelnen Aufschlüsselung der Angaben zu den erforderlichen GZR-Auskünften.</xs:documentation>
               </xs:annotation>
               <xs:complexType>
                  <xs:sequence>
                     <xs:element name="beantragtFuer.id" type="bdt:IDType">
                        <xs:annotation>
                           <xs:documentation>Angabe der Person, auf welche sich die Beantragung bezieht.</xs:documentation>
                        </xs:annotation>
                     </xs:element>
                     <xs:element name="antragsstatus">
                        <xs:annotation>
                           <xs:documentation>Angaben zum Antragsstatus.</xs:documentation>
                        </xs:annotation>
                        <xs:complexType>
                           <xs:choice>
                              <xs:element name="datumBeantragungAuskunftGZR" minOccurs="0" type="xs:date">
                                 <xs:annotation>
                                    <xs:documentation>Datum der Beantragung einer Auskunft aus dem Gewerbezentralregister zur Vorlage bei einer Behörde (Belegart 9).</xs:documentation>
                                 </xs:annotation>
                              </xs:element>
                              <xs:element name="datumGeplanteBeantragungAuskunftGZR"
                                          minOccurs="0"
                                          type="xs:date">
                                 <xs:annotation>
                                    <xs:documentation>Datum der geplanten Beantragung einer Auskunft aus dem Gewerbezentralregister zur Vorlage bei einer Behörde (Belegart 9).</xs:documentation>
                                 </xs:annotation>
                              </xs:element>
                              <xs:element name="nachholungBeantragungAuskunftGZR"
                                          minOccurs="0"
                                          fixed="true"
                                          type="xs:boolean">
                                 <xs:annotation>
                                    <xs:documentation>Angabe, ob die Beantragung einer Auskunft aus dem Gewerbezentralregister zur Vorlage bei einer Behörde (Belegart 9) nachgeholt wird.</xs:documentation>
                                 </xs:annotation>
                              </xs:element>
                           </xs:choice>
                        </xs:complexType>
                     </xs:element>
                  </xs:sequence>
               </xs:complexType>
            </xs:element>
         </xs:choice>
      </xs:complexType>
   </xs:element>
   <xs:element name="gewerbebetrieb">
      <xs:annotation>
         <xs:documentation>Angaben zu dem Gewerbebetrieb, in welchem die erlaubnispflichtige Tätigkeit ausgeübt werden soll. Ein Gewerbebetrieb beschreibt die wirtschaftliche Einheit, unter der ein oder mehrere Gewerbetreibende/r im Außenverhältnis am Wirtschaftsleben teilnehmen.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="wt:wirtschaftlichTaetiger.id">
               <xs:annotation>
                  <xs:documentation>Angabe des wirtschaftlich Tätigen als ID-Querverweis innerhalb des jeweiligen Kontextes (Nachricht, Datensatz) auf ein Element np:natuerlichePerson, jp:juristischePerson, pg:rechtsfaehigePersonengesellschaft, pv:sonstigePersonenvereinigung (oder auf ein entsprechendes abgeleitetes Element).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="rf:rechtsform">
               <xs:annotation>
                  <xs:documentation>Angabe der Rechtsform. Es dürfen ausschließlich die in beschriebenen Rechtsformen-Codes verwendet werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="ename:eingetragenerName" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Die im Handels-, Genossenschafts oder Gesellschaftsregister eingetragene Firma eines wirtschaftlich Tätigen bzw. einer wirtschaftlichen Tätigkeit (z. B. eingetragenes Einzelunternehmen, eingetragene Zweigniederlassung) bzw. der im Vereinsregister, Partnerschaftsregister oder Stiftungsverzeichnis eingetragene Name. Der eingetragene Name kann auch in einem Register festgehalten sein, welches in einem anderen Staat geführt wird.Der eingetragene Name ist abzugrenzen von der Geschäftsbezeichnung.Das Kerndatenobjekt bildet auch die Namen juristischer Personen, rechtsfähiger Personengesellschaften oder sonstiger Personenvereinigungen ab, die nicht in einem Register, aber kraft Gesetz geführt werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:eintragung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Kerndatenobjekt fasst die Daten, mit welchen die Eintragung eines wirtschaftlich Tätigen bzw. eines Gewerbebetriebs in ein Register (Handels-, Genossenschafts- oder Vereinsregister) oder in ein Verzeichnis (Stiftungsverzeichnis) identifiziert werden kann.Die Eintragung kann auch in ein Register oder Verzeichnis erfolgen, welches in einem anderen Staat geführt wird.Zwischen Rechtsform und Eintragung besteht ein Zusammenhang. Welche Eintragungsarten (Handelsregister A, Handelsregister B, Genossenschaftsregister, Vereinsregister, Register im Ausland, Kraft Gesetz) für welche Rechtsformen zulässig sein können, wird als Information in der Codeliste der Rechtsformen mitgeführt. Das Objekt ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Semantisch konkretisiert auf Gewerbebetriebe als Art der wirtschaftlichen Tätigkeit Keine Eintragung im Partnerschaftsregister zulässig Eintragungsdatum als optionale Angabe Das Element staat wurde nicht aus dem Basismodul übernommen, da dort Code und nicht Freitext vorgesehen ist.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="wt:geschaeftsbezeichnung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Zur Außendarstellung einer wirtschaftlichen Tätigkeit oder einer Betriebsstätte verwendeter Name, der nicht im Handel-, Genossenschafts-, Partnerschafts- oder Vereinsregister eingetragen ist oder davon abweicht (z.B. Gasthof "Zum lustigen Wirt"; "Ruck-Zuck-GbR").</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:betriebsstaette" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angabe zur bestehenden oder geplanten Hauptniederlassung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:fruehereHauptniederlassung"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu einer früheren Hauptniederlassung in den letzten fünf Jahren.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="betriebsleiter.id"
                        minOccurs="0"
                        maxOccurs="unbounded"
                        type="bdt:IDType">
               <xs:annotation>
                  <xs:documentation>Referenz auf einen Betriebsleiter.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="auslandstaetigkeitIn"
                        minOccurs="0"
                        maxOccurs="unbounded"
                        type="adr:Code.Staat">
               <xs:annotation>
                  <xs:documentation>Angaben zu einer Tätigkeit außerhalb Deutschlands in einem EU- bzw. EWR-Staat im Rahmen des freien Dienstleistungsverkehrs.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:auslandsniederlassung" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>In diesem Typ werden Angaben der Geschäftsanschrift einer Zweigniederlassung oder ständigen Präsenz außerhalb Deutschlands in einem EU- bzw. EWR-Staat zusammengefasst.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="gewerberechtlicheZulassung">
      <xs:annotation>
         <xs:documentation>In diesem Typ werden die Angaben zu einem laufenden oder abgeschlossenen gewerberechtlichen Zulassungsverfahren zusammengefasst (z.B. für die Ausübung eines Gewerbes oder im Rahmen einer Erlaubnis nach § 34c, § 34d oder § 34i GewO).</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="status" type="bk:Code.Status">
               <xs:annotation>
                  <xs:documentation>Angabe zum Status des Erlaubnisverfahrens.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="umfang" minOccurs="0" type="erl:Code.Erlaubnisarten">
               <xs:annotation>
                  <xs:documentation>Umfang der gewerberechtlichen Erlaubnis</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="datumAusstellungOderBeantragung" minOccurs="0" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Datum der Ausstellung oder Beantragung einer Erlaubnis.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="behoerde" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Behörde, die die Erlaubnis ausgestellt hat oder bei der die Erlaubnis beantragt wurde.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="ihkIdentnummer" type="bdt:String.DIN91379.C">
      <xs:annotation>
         <xs:documentation>Identnummer bei der IHK zur eindeutigen Identifizierung einer natürlichen oder juristischen Person.</xs:documentation>
      </xs:annotation>
   </xs:element>
   <xs:element name="juristischePerson">
      <xs:annotation>
         <xs:documentation>Unter juristischen Personen werden sowohl die Körperschaften des Privatrechts (Gesellschaft mit beschränkter Haftung, Aktiengesellschaft, Kommanditgesellschaft auf Aktien, eingetragener Verein, Genossenschaft) als auch öffentlich-rechtliche Körperschaften (Gebietskörperschaften, Selbstverwaltungskörperschaften, sonstige Körperschaften des öffentlichen Rechts) erfasst.Die konkrete Rechtsform der juristischen Person kann mittels einer Codeliste angegeben werden. Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Zustellanschrift mit spezifischerem Datentyp. Fachspezifische Angaben ergänzt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="jp:juristischePerson.id">
               <xs:annotation>
                  <xs:documentation>Innerhalb des jeweiligen Kontextes eindeutige ID dieser Instanz des Kerndatenobjekts Juristische Person.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="rf:rechtsform">
               <xs:annotation>
                  <xs:documentation>Angabe der Rechtsform. Es dürfen ausschließlich die in beschriebenen Rechtsformen-Codes verwendet werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="ename:eingetragenerName">
               <xs:annotation>
                  <xs:documentation>Die im Handels-, Genossenschafts oder Gesellschaftsregister eingetragene Firma eines wirtschaftlich Tätigen bzw. einer wirtschaftlichen Tätigkeit (z. B. eingetragenes Einzelunternehmen, eingetragene Zweigniederlassung) bzw. der im Vereinsregister, Partnerschaftsregister oder Stiftungsverzeichnis eingetragene Name. Der eingetragene Name kann auch in einem Register festgehalten sein, welches in einem anderen Staat geführt wird.Der eingetragene Name ist abzugrenzen von der Geschäftsbezeichnung.Das Kerndatenobjekt bildet auch die Namen juristischer Personen, rechtsfähiger Personengesellschaften oder sonstiger Personenvereinigungen ab, die nicht in einem Register, aber kraft Gesetz geführt werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:eintragung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Kerndatenobjekt fasst die Daten, mit welchen die Eintragung eines wirtschaftlich Tätigen bzw. eines Gewerbebetriebs in ein Register (Handels-, Genossenschafts- oder Vereinsregister) oder in ein Verzeichnis (Stiftungsverzeichnis) identifiziert werden kann.Die Eintragung kann auch in ein Register oder Verzeichnis erfolgen, welches in einem anderen Staat geführt wird.Zwischen Rechtsform und Eintragung besteht ein Zusammenhang. Welche Eintragungsarten (Handelsregister A, Handelsregister B, Genossenschaftsregister, Vereinsregister, Register im Ausland, Kraft Gesetz) für welche Rechtsformen zulässig sein können, wird als Information in der Codeliste der Rechtsformen mitgeführt. Das Objekt ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Semantisch konkretisiert auf Gewerbebetriebe als Art der wirtschaftlichen Tätigkeit Keine Eintragung im Partnerschaftsregister zulässig Eintragungsdatum als optionale Angabe Das Element staat wurde nicht aus dem Basismodul übernommen, da dort Code und nicht Freitext vorgesehen ist.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:zustellanschrift" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dies ist eine Rolle, welche das Kerndatenobjekt Anschrift einnehmen kann. Mit der Rolle wird eine Anschrift für die Zustellung von Schriftstücken angegeben. Eine Zustellanschrift ist insbesondere die im Handels- oder Genossenschaftsregister eingetragene inländische Geschäftsanschrift (vgl. §§ 29, 106 HGB). Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Spezifischere Darstellung für die Strassenanschrift. Abweichende, strukturierte Darstellung für die Auslandsanschriften.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="kom:kommunikation" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Telefon, Telefax, Email-Adresse und/oder Webseite.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="gv:gesetzlicherVertreter.id" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angabe eines gesetzlichen Vertreters als ID-Querverweis innerhalb des jeweiligen Kontextes (Nachricht, Datensatz) auf ein Element np:natuerlichePerson, jp:juristischePerson, pg:rechtsfaehigePersonengesellschaft, pv:sonstigePersonenvereinigung (oder auf ein entsprechendes abgeleitetes Element).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:gewerberechtlicheZulassung"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>In diesem Typ werden die Angaben zu einem laufenden oder abgeschlossenen gewerberechtlichen Zulassungsverfahren zusammengefasst (z.B. für die Ausübung eines Gewerbes oder im Rahmen einer Erlaubnis nach § 34c, § 34d oder § 34i GewO).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:ihkIdentnummer" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Identnummer bei der IHK zur eindeutigen Identifizierung einer natürlichen oder juristischen Person.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="natuerlichePerson">
      <xs:annotation>
         <xs:documentation>Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Geburt und Anschrift mit spezifischeren Datentypen. Fachspezifische Angaben ergänzt. Hinweis: Die Angabe nichtVorhanden ist nur dann zulässig, wenn der jeweilige Namensbestandteil zu Recht nicht vorhanden ist.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="np:natuerlichePerson.id">
               <xs:annotation>
                  <xs:documentation>Innerhalb des jeweiligen Kontextes eindeutige ID dieser Instanz des Kerndatenobjekts Natürliche Person.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="np:doktorgrad" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Es sind nur diejenigen Doktorgrade anzugeben, die in Pässe eingetragen werden dürfen. Sind mehrere Doktorgrade anzugeben, so sind sie durch ein Leerzeichen zu trennen.Zulässig sind derzeit: „DR.“, „Dr.“, „DR.HC.“, „Dr.hc.“, „Dr.EH.“ und „Dr.eh.“.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="np:name">
               <xs:annotation>
                  <xs:documentation>Datenobjekt zur Darstellung des Namens einer natürlichen Person in lateinischer Schrift, entsprechend der Vorgaben aus dem Baukasten des Förderalen Informationsmanagements (FIM).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:geburt" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Angabe zum Staat als Freitext statt Code.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="np:geschlecht" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Als Geschlechtsangabe zulässig sind: "männlich", "weiblich", "divers", "keine Angabe".</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="np:staatsangehoerigkeit" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Die Staatsangehörigkeit der natürlichen Person gemäß Codierung des statistischen Bundesamts.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:staatsangehoerigkeitFreitext" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Hier ist die Staatsangehörigkeit zu übermitteln, sofern kein passender Code in np:staatsangehoerigkeit angegeben werden kann.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:anschrift" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Detailliertere Struktur für die Strassenanschrift. Detailliertere Struktur für die Auslandsanschriften. Keine Postfachanschrift.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:fruehererHauptwohnsitz"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angabe der weiteren Hauptwohnsitze, an denen die Person in den letzten 5 Jahren gemeldet war.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="kom:kommunikation" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Telefon, Telefax, Email-Adresse und/oder Webseite.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:sachkundenachweis" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Mit diesem Typ werden die Angaben zur Sachkunde zusammengefasst, die in einigen erlaubnispflichtigen Gewerben erforderlich ist. Ein Nachweis der Sachkunde ist beispielsweise für die Beantragung einer Erlaubnis für Versicherungsvermittler / Versicherungsberater (§ 34d GewO) erforderlich.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:gewerberechtlicheZulassung"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>In diesem Typ werden die Angaben zu einem laufenden oder abgeschlossenen gewerberechtlichen Zulassungsverfahren zusammengefasst (z.B. für die Ausübung eines Gewerbes oder im Rahmen einer Erlaubnis nach § 34c, § 34d oder § 34i GewO).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:ihkIdentnummer" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Identnummer bei der IHK zur eindeutigen Identifizierung einer natürlichen oder juristischen Person.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:aufenthaltstitel" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zur Aufenthaltsgenehmigung bei Staatsangehörigkeit eines Drittstaats / eines Nicht-EU-Landes</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="oeffnungszeit">
      <xs:annotation>
         <xs:documentation>Angabe zu Öffnungszeiten an einem bestimmten Wochentag.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="wochentag" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe des Wochentags.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:oeffnungszeit.zeitspanne" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angabe einer Zeitspanne über zwei Uhrzeiten.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="oeffnungszeit.zeitspanne">
      <xs:annotation>
         <xs:documentation>Angabe einer Zeitspanne über zwei Uhrzeiten.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="beginn" type="xs:time">
               <xs:annotation>
                  <xs:documentation>Angabe des Startzeitpunkts.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ende" type="xs:time">
               <xs:annotation>
                  <xs:documentation>Angabe des Endzeitpunkts.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="rechtsfaehigePersonengesellschaft">
      <xs:annotation>
         <xs:documentation>Die rechtsfähige Personengesellschaft im Kontext von XGewerbeordnung umfasst sowohl die rechtsfähige Gesellschaft des Bürgerlichen Rechts (GbR), als auch Personenhandelsgesellschaften wie die Offene Handelsgesellschaft (oHG), die Kommanditgesellschaft (KG) und die Kapitalgesellschaft amp Co. KG. Entsprechend sind rechtsfähige Personengesellschaften nach ausländischem und supranationalem Recht zu berücksichtigen.Die konkrete Rechtsform der rechtsfähigen Personengesellschaft kann mittels einer Codeliste angegeben werden. Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Einschränkung: Keine Partnerschaftsgesellschaften. Zustellanschrift mit spezifischerem Datentyp. Fachspezifische Angaben ergänzt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="rpg:rechtsfaehigePersonengesellschaft.id">
               <xs:annotation>
                  <xs:documentation>Innerhalb des jeweiligen Kontextes eindeutige ID dieser Instanz des Kerndatenobjekts Rechtsfähige Personengesellschaft.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="rf:rechtsform">
               <xs:annotation>
                  <xs:documentation>Angabe der Rechtsform. Es dürfen ausschließlich die in beschriebenen Rechtsformen-Codes verwendet werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="ename:eingetragenerName" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Die im Handels-, Genossenschafts oder Gesellschaftsregister eingetragene Firma eines wirtschaftlich Tätigen bzw. einer wirtschaftlichen Tätigkeit (z. B. eingetragenes Einzelunternehmen, eingetragene Zweigniederlassung) bzw. der im Vereinsregister, Partnerschaftsregister oder Stiftungsverzeichnis eingetragene Name. Der eingetragene Name kann auch in einem Register festgehalten sein, welches in einem anderen Staat geführt wird.Der eingetragene Name ist abzugrenzen von der Geschäftsbezeichnung.Das Kerndatenobjekt bildet auch die Namen juristischer Personen, rechtsfähiger Personengesellschaften oder sonstiger Personenvereinigungen ab, die nicht in einem Register, aber kraft Gesetz geführt werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:eintragung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Kerndatenobjekt fasst die Daten, mit welchen die Eintragung eines wirtschaftlich Tätigen bzw. eines Gewerbebetriebs in ein Register (Handels-, Genossenschafts- oder Vereinsregister) oder in ein Verzeichnis (Stiftungsverzeichnis) identifiziert werden kann.Die Eintragung kann auch in ein Register oder Verzeichnis erfolgen, welches in einem anderen Staat geführt wird.Zwischen Rechtsform und Eintragung besteht ein Zusammenhang. Welche Eintragungsarten (Handelsregister A, Handelsregister B, Genossenschaftsregister, Vereinsregister, Register im Ausland, Kraft Gesetz) für welche Rechtsformen zulässig sein können, wird als Information in der Codeliste der Rechtsformen mitgeführt. Das Objekt ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Semantisch konkretisiert auf Gewerbebetriebe als Art der wirtschaftlichen Tätigkeit Keine Eintragung im Partnerschaftsregister zulässig Eintragungsdatum als optionale Angabe Das Element staat wurde nicht aus dem Basismodul übernommen, da dort Code und nicht Freitext vorgesehen ist.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:zustellanschrift" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dies ist eine Rolle, welche das Kerndatenobjekt Anschrift einnehmen kann. Mit der Rolle wird eine Anschrift für die Zustellung von Schriftstücken angegeben. Eine Zustellanschrift ist insbesondere die im Handels- oder Genossenschaftsregister eingetragene inländische Geschäftsanschrift (vgl. §§ 29, 106 HGB). Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Spezifischere Darstellung für die Strassenanschrift. Abweichende, strukturierte Darstellung für die Auslandsanschriften.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="kom:kommunikation" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Telefon, Telefax, Email-Adresse und/oder Webseite.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="ges:gesellschafter.id" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angabe eines Gesellschafters als ID-Querverweis innerhalb des jeweiligen Kontextes (Nachricht, Datensatz) auf ein Element np:natuerlichePerson, jp:juristischePerson, pg:rechtsfaehigePersonengesellschaft, pv:sonstigePersonenvereinigung (oder auf ein entsprechendes abgeleitetes Element).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:gewerberechtlicheZulassung"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>In diesem Typ werden die Angaben zu einem laufenden oder abgeschlossenen gewerberechtlichen Zulassungsverfahren zusammengefasst (z.B. für die Ausübung eines Gewerbes oder im Rahmen einer Erlaubnis nach § 34c, § 34d oder § 34i GewO).</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="reisegewerbekarte">
      <xs:annotation>
         <xs:documentation>Angaben zu einer Reisegewerbekarte.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="status" type="bk:Code.Status">
               <xs:annotation>
                  <xs:documentation>Status der Reisegewerbekarte.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="gueltigkeitsdauer"
                        minOccurs="0"
                        type="erl:Code.GueltigkeitsdauerReisegewerbekarte">
               <xs:annotation>
                  <xs:documentation>Angabe zur Gültigkeitdauer der Reisegewerbekarte (befristet / unbefristet).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="zeitpunktBefristung" minOccurs="0" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Zeitpunkt der Befristung der Reisegewerbekarte.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="nummer" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Nummer der Reisegewerbekarte.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ausgestelltVon" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Name der Behörde, welche die Reisegewerbekarte ausgestellt hat.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ausgestelltAm" minOccurs="0" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Ausstellungsdatum der Reisegewerbekarte.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="sachkundedelegation">
      <xs:annotation>
         <xs:documentation>In diesem Typ werden Angaben zur Sachkundedelegation zusammengefasst.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="vertretungsberechtigteAufsichtsperson.id" type="bdt:IDType">
               <xs:annotation>
                  <xs:documentation>Referenz auf die natürliche Person, welche statt der gesetzlichen Vertreter den Nachweis der Sachkunde erbringt und Leistungserbringung im erlaubnispflichtigen Gewerbe beaufsichtigt.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="anzahlBetreuteAngestellte"
                        minOccurs="0"
                        type="xs:nonNegativeInteger">
               <xs:annotation>
                  <xs:documentation>Angabe der Personenzahl, über die eine angestellte Aufsichtsperson mit Sachkunde die Aufsicht bezüglich Versicherungsvermittlung oder Versicherungsberatung führt.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="sachkundenachweis">
      <xs:annotation>
         <xs:documentation>Mit diesem Typ werden die Angaben zur Sachkunde zusammengefasst, die in einigen erlaubnispflichtigen Gewerben erforderlich ist. Ein Nachweis der Sachkunde ist beispielsweise für die Beantragung einer Erlaubnis für Versicherungsvermittler / Versicherungsberater (§ 34d GewO) erforderlich.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="artSachkundenachweis"
                        minOccurs="0"
                        type="erl:Code.ArtSachkundenachweis">
               <xs:annotation>
                  <xs:documentation>Angabe zur Art des Sachkundenachweises.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="qualifikation"
                        minOccurs="0"
                        maxOccurs="unbounded"
                        type="erl:Code.Qualifikation">
               <xs:annotation>
                  <xs:documentation>Angabe der Qualifikation, die als Nachweis der Sachkunde vorgelegt wird.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="sonstigePersonenvereinigung">
      <xs:annotation>
         <xs:documentation>Hierunter werden alle Personenvereinigungen gefasst, die weder unter juristische Personen noch unter rechtsfähige Personengesellschaften fallen. Die sonstigen Personenvereinigungen (z. B. die Erbengemeinschaft) werden in der Regel nicht wirtschaftlich tätig.Die konkrete Rechtsform der sonstigen Personenvereinigung kann mittels einer Codeliste angegeben werden. Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Zustellanschrift mit spezifischerem Datentyp. Fachspezifische Angaben ergänzt.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="spv:sonstigePersonenvereinigung.id">
               <xs:annotation>
                  <xs:documentation>Innerhalb des jeweiligen Kontextes eindeutige ID dieser Instanz des Kerndatenobjekts Sonstige Personenvereinigung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="rf:rechtsform">
               <xs:annotation>
                  <xs:documentation>Angabe der Rechtsform. Es dürfen ausschließlich die in beschriebenen Rechtsformen-Codes verwendet werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="ename:eingetragenerName" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Die im Handels-, Genossenschafts oder Gesellschaftsregister eingetragene Firma eines wirtschaftlich Tätigen bzw. einer wirtschaftlichen Tätigkeit (z. B. eingetragenes Einzelunternehmen, eingetragene Zweigniederlassung) bzw. der im Vereinsregister, Partnerschaftsregister oder Stiftungsverzeichnis eingetragene Name. Der eingetragene Name kann auch in einem Register festgehalten sein, welches in einem anderen Staat geführt wird.Der eingetragene Name ist abzugrenzen von der Geschäftsbezeichnung.Das Kerndatenobjekt bildet auch die Namen juristischer Personen, rechtsfähiger Personengesellschaften oder sonstiger Personenvereinigungen ab, die nicht in einem Register, aber kraft Gesetz geführt werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:eintragung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Kerndatenobjekt fasst die Daten, mit welchen die Eintragung eines wirtschaftlich Tätigen bzw. eines Gewerbebetriebs in ein Register (Handels-, Genossenschafts- oder Vereinsregister) oder in ein Verzeichnis (Stiftungsverzeichnis) identifiziert werden kann.Die Eintragung kann auch in ein Register oder Verzeichnis erfolgen, welches in einem anderen Staat geführt wird.Zwischen Rechtsform und Eintragung besteht ein Zusammenhang. Welche Eintragungsarten (Handelsregister A, Handelsregister B, Genossenschaftsregister, Vereinsregister, Register im Ausland, Kraft Gesetz) für welche Rechtsformen zulässig sein können, wird als Information in der Codeliste der Rechtsformen mitgeführt. Das Objekt ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Semantisch konkretisiert auf Gewerbebetriebe als Art der wirtschaftlichen Tätigkeit Keine Eintragung im Partnerschaftsregister zulässig Eintragungsdatum als optionale Angabe Das Element staat wurde nicht aus dem Basismodul übernommen, da dort Code und nicht Freitext vorgesehen ist.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:zustellanschrift" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dies ist eine Rolle, welche das Kerndatenobjekt Anschrift einnehmen kann. Mit der Rolle wird eine Anschrift für die Zustellung von Schriftstücken angegeben. Eine Zustellanschrift ist insbesondere die im Handels- oder Genossenschaftsregister eingetragene inländische Geschäftsanschrift (vgl. §§ 29, 106 HGB). Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Spezifischere Darstellung für die Strassenanschrift. Abweichende, strukturierte Darstellung für die Auslandsanschriften.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="kom:kommunikation" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Telefon, Telefax, Email-Adresse und/oder Webseite.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="gv:gesetzlicherVertreter.id"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angabe eines gesetzlichen Vertreters als ID-Querverweis innerhalb des jeweiligen Kontextes (Nachricht, Datensatz) auf ein Element np:natuerlichePerson, jp:juristischePerson, pg:rechtsfaehigePersonengesellschaft, pv:sonstigePersonenvereinigung (oder auf ein entsprechendes abgeleitetes Element).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:gewerberechtlicheZulassung"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>In diesem Typ werden die Angaben zu einem laufenden oder abgeschlossenen gewerberechtlichen Zulassungsverfahren zusammengefasst (z.B. für die Ausübung eines Gewerbes oder im Rahmen einer Erlaubnis nach § 34c, § 34d oder § 34i GewO).</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="veranstaltungSpiel">
      <xs:annotation>
         <xs:documentation>Angaben zur Veranstaltung eines (anderen) Spiels mit Gewinnmöglichkeit.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="bezeichnungSpiel" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe der genauen Bezeichnung des Spiels.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="bezeichnungVeranstaltungsort" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Bezeichnung des Veranstaltungsortes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:anschrift">
               <xs:annotation>
                  <xs:documentation>Adresse des Veranstaltungsortes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="zeitraumVon" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Angabe des Startdatums der Veranstaltung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="zeitraumBis" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Angabe des Enddatums der Veranstaltung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="veranstaltungBetreiber.id" type="bdt:IDType">
               <xs:annotation>
                  <xs:documentation>Angaben zum Betreiber des Veranstaltungsortes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:angabenSpielgeraeteSpiele"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu aufgestellten Spielgeräten (§ 33c GewO) oder durchgeführten Spielen (§ 33d GewO).</xs:documentation>
               </xs:annotation>
