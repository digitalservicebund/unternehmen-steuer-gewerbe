               </xs:annotation>
            </xs:element>
            <xs:element name="ausgestelltVonOrt" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Ort der den Aufenthaltstitel ausstellenden Behörde</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="auflagen" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Beschreibt eine oder mehrere die Erwerbstätigkeit betreffende Auflagen und/oder Beschränkungen zum Aufenthaltstitel in Textform (z.B. "Gültig bis zum 01.02.2033").</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="betriebArt">
