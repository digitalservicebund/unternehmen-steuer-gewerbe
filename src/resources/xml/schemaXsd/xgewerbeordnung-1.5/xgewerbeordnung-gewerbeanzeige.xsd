         <xs:element ref="xga:abmeldung"/>
         <xs:element ref="xga:datenaktualisierung"/>
      </xs:choice>
   </xs:complexType>
   <xs:complexType name="ea.satz">
      <xs:choice>
         <xs:element ref="xga:anmeldung"/>
