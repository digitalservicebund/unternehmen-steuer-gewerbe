   <xs:element name="abmeldung">
      <xs:annotation>
         <xs:documentation>Dieses Element umfasst alle Angaben, die in einer Gewerbeabmeldung übermittelt werden können.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="xga:Gewerbemeldung">
               <xs:sequence>
                  <xs:element ref="xga:kuenftigesGewerbe" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Angaben zum künftigen Gewerbe.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="grundAbmeldungSchluessel"
                              minOccurs="0"
                              type="xga:Code.GrundFuerAbmeldung"/>
                  <xs:element name="ursacheAbmeldung" minOccurs="0" type="bdt:String.DIN91379.C"/>
                  <xs:element name="ursacheAbmeldungSchluessel"
                              minOccurs="0"
                              type="xga:Code.UrsacheFuerAbmeldung"/>
                  <xs:element name="istTechnischeAbmeldung" minOccurs="0" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Falls es sich bei der Abmeldung um eine (Wieder)Abmeldung zur Rücknahme oder Korrektur einer irrtümlichen Anmeldung nach Ablauf der Stornierungsfrist von 42 Tagen handelt, so ist dies mit dem Wert "true" in diesem Datentypen anzugeben (vgl. ).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
