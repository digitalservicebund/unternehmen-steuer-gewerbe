               </xs:annotation>
            </xs:element>
            <xs:element name="wesentlich" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Wesentliches Angebot eines oder mehrerer Wirtschaftszweige, mindestens nationales Angebot.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="aufenthaltstitel">
