                  <xs:documentation>Angabe des Startdatums der Veranstaltung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="zeitraumBis" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Angabe des Enddatums der Veranstaltung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="veranstaltungBetreiber.id" type="bdt:IDType">
               <xs:annotation>
                  <xs:documentation>Angaben zum Betreiber des Veranstaltungsortes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:angabenSpielgeraeteSpiele"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu aufgestellten Spielgeräten (§ 33c GewO) oder durchgeführten Spielen (§ 33d GewO).</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="veranstaltungsdatum">
      <xs:annotation>
         <xs:documentation>Angaben zu einem Veranstaltungsdatum.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="startdatum" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Angabe des Startdatums der Veranstaltung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="von" type="xs:time">
               <xs:annotation>
                  <xs:documentation>Angabe des Startzeitpunkts (Uhrzeit) des Betriebs.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="enddatum" type="xs:date">
               <xs:annotation>
                  <xs:documentation>Angabe des Enddatums der Veranstaltung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="bis" type="xs:time">
               <xs:annotation>
                  <xs:documentation>Angabe des Endzeitpunkts (Uhrzeit) des Betriebs.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="veranstaltungsortMarktfestsetzung">
      <xs:annotation>
         <xs:documentation>Angaben zum Veranstaltungsort im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="bk:strassenanschriftInland" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben für die Adressierung im Inland, soweit es sich um die Anschrift eines Gebäudes handelt. Dieses Element ist gegenüber der Definition aus dem Kerndatenmodell wie folgt konkretisiert: Hausnummer differenziert (von, bis). Straßenschlüssel ergänzt. Ortsteil ergänzt.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="veranstaltungsort"
                        minOccurs="0"
                        type="erl:Code.VeranstaltungsortMarktfestsetzung">
               <xs:annotation>
                  <xs:documentation>Angabe des Veranstaltungsortes (Auswahlmöglichkeit)</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="plz" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Postleitzahl der Ortsbeschreibung (falls keine Strassenanschrift).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="ort" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Ort in der Ortsbeschreibung (falls keine Strassenanschrift).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="keinePlzUndOrt" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Angabe, dass der Veranstaltungsort weder Postleitzahl noch Ort hat.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="beschreibung" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Beschreibung des Ortes.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="veranstaltungszweckMarktfestsetzung">
      <xs:annotation>
         <xs:documentation>Angaben zum Zweck der Veranstaltung im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="vertriebVonWaren" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Vertrieb von Waren.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="vertriebVonWarenSoweitUeblich"
                        minOccurs="0"
                        type="xs:boolean">
