               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:oeffnungszeitWochentage"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Öffnungszeiten an bestimmten Wochentagen.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:abweichendeOeffnungszeitZeitraum"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Öffnungszeiten in einem bestimmten Zeitraum im Rahmen der Zeitangaben zur Marktfestsetzung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:abweichendeOeffnungszeitWochentage"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu abweichenden Öffnungszeiten an bestimmten Wochentagen im Rahmen der Zeitangaben zur Marktfestsetzung.</xs:documentation>
               </xs:annotation>
