                     </xs:annotation>
                  </xs:element>
                  <xs:element name="veranstaltungsort"
                              minOccurs="0"
                              type="bk:StrassenanschriftInlandType">
                     <xs:annotation>
                        <xs:documentation>Ort der Veranstaltung (nur bei § 69 Abs. 1 Satz 1 GewO).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="veranstaltungsart" minOccurs="0" type="bdt:String.DIN91379.C">
                     <xs:annotation>
                        <xs:documentation>Art der Veranstaltung (nur bei § 69 Abs. 1 Satz 1 GewO).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="erl:zuPruefendePersonParagraph7">
                     <xs:annotation>
                        <xs:documentation>Angaben zu einer natürlichen Person, deren Zuverlässigkeit nach § 7 GewO zu prüfen ist.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="gewo.mitteilungreisegewerbekarte.1810">
      <xs:annotation>
         <xs:documentation>Übermittlung einer Reisegewerbekarte nach § 195 Abs. 2 SGB VII durch eine Gewerbebehörde an die DGUV.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="erl:AnzeigeMitteilung">
               <xs:sequence>
                  <xs:element name="anlassMitteilung"
                              type="erl:Code.AnlassMitteilungReisegewerbekarte">
                     <xs:annotation>
                        <xs:documentation>Anlass der Mitteilung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="gewerbetreibender.id" type="bdt:IDType">
                     <xs:annotation>
                        <xs:documentation>Verweis auf den Gewerbetreibenden.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="erl:gewerbebetrieb" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Angaben zu dem Gewerbebetrieb, in welchem die Tätigkeit ausgeübt werden soll. Ein Gewerbebetrieb beschreibt die wirtschaftliche Einheit, unter der ein oder mehrere Gewerbetreibende/r im Außenverhältnis am Wirtschaftsleben teilnehmen.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="bk:bisherigeUnfallversicherung" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Angaben zur bisherigen Unfallversicherung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
