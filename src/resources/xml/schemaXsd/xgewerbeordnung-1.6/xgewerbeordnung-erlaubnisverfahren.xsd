                  <xs:element name="startdatumVeranstaltung" minOccurs="0" type="xs:date">
                     <xs:annotation>
                        <xs:documentation>Startdatum der Veranstaltung (nur Erlaubnis zum Feilbieten).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="enddatumVeranstaltung" minOccurs="0" type="xs:date">
                     <xs:annotation>
                        <xs:documentation>Enddatum der Veranstaltung (nur Erlaubnis zum Feilbieten).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="zweitschriftReisegewerbekarte"
                              minOccurs="0"
                              type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Angabe, ob eine Zweitschrift der Reisegewerbekarte beantragt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="anzahlZweitschriften" minOccurs="0" type="xs:positiveInteger">
                     <xs:annotation>
                        <xs:documentation>Angabe der Anzahl der beantragten Zweitschriften.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="erl:zuverlaessigkeit" minOccurs="0">
                     <xs:annotation>
                        <xs:documentation>Angaben, welche zur Beurteilung der Zuverlässigkeit erforderlich sind. Zu der Beurteilung der Zuverlässigkeit können Angaben oder Nachweise insbesondere zu folgenden Sachverhalten erforderlich sein: Nichtvorliegen von Straftaten und Ordnungswidrigkeiten (BZR/GZR-Auszug), geordnete Vermögensverhältnisse.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="erl:bZRAuskunft">
                     <xs:annotation>
                        <xs:documentation>Datum der Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O).</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element ref="erl:gZRAuskunft">
                     <xs:annotation>
                        <xs:documentation>Angabe, ob die Beantragung einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O) nachgeholt wird.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="gewo.antrag35.1400">
      <xs:annotation>
         <xs:documentation>Übermittlung eines Antrags auf Wiedergestattung eines Gewerbes nach Untersagung gemäß § 35 GewO durch einen Online-Dienst an eine zuständige Stelle.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:complexContent>
            <xs:extension base="erl:Erlaubnisantrag">
               <xs:sequence>
                  <xs:element name="datumUntersagungsbescheid" minOccurs="0" type="xs:date">
                     <xs:annotation>
                        <xs:documentation>Datum des Untersagungsbescheids.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="datumGewerbeabmeldung" minOccurs="0" type="xs:date">
                     <xs:annotation>
                        <xs:documentation>Datum der Gewerbeabmeldung.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
                  <xs:element name="angabeAbsichtGewerbeausuebung" type="xs:boolean">
                     <xs:annotation>
                        <xs:documentation>Angabe, ob der Antragsteller die konkrete Absicht hat, ein Gewerbe auszuüben.</xs:documentation>
                     </xs:annotation>
                  </xs:element>
               </xs:sequence>
            </xs:extension>
         </xs:complexContent>
      </xs:complexType>
   </xs:element>
   <xs:element name="gewo.erlaubnisantrag69.1410">
      <xs:annotation>
         <xs:documentation>Übermittlung eines Antrags auf Erteilung einer gewerberechtlichen Erlaubnis nach § 69 GewO durch einen Online-Dienst an eine zuständige Stelle.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="uuid" type="bdt:UUID">
               <xs:annotation>
                  <xs:documentation>Eine vom Online-Dienst vergebene eindeutige Kennung des Antragsvorgangs.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="zeitstempelAntragsstellung" type="xs:dateTime">
               <xs:annotation>
                  <xs:documentation>Der vom Online-Dienst festgestellte Zeitpunkt, an welchem der Antrag erfolgreich durch den Nutzer gestellt wurde.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="antr:antragsteller.id">
               <xs:annotation>
                  <xs:documentation>ID-Verweis innerhalb des jeweiligen Kontextes auf ein Element erl:natuerlichePerson oder erl:juristischePerson in der Rolle Antragsteller.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="antr:handelndePerson.id">
               <xs:annotation>
                  <xs:documentation>ID-Verweis innerhalb des jeweiligen Kontextes auf ein Element erl:natuerlichePerson in der Rolle Handelnde Person.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:handelndePerson.vertrauensniveauIdentifikation">
               <xs:annotation>
                  <xs:documentation>Das Vertrauensniveau gemäß welchem die Identität der handelnden natürlichen Person vom Online-Dienst festgestellt wurde.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="antr:ansprechpartner.id" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angabe des Ansprechpartners als ID-Querverweis innerhalb des jeweiligen Kontextes (Nachricht, Datensatz) auf ein Element np:natuerlichePerson (oder auf ein entsprechendes abgeleitetes Element).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:nachweisdokument.onlinedienst"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Vom Online-Dienst selbst erstellte Nachweisdokumente zur Ablage in der Akte der fachlich zuständigen Stelle. Beispiel: Die Willenserklärung eines oder der Antragstellenden "im Original".</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bk:nachweisdokument.upload"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Vom Anwender hochgeladene Nachweisdokumente (hochgeladene Fotos, Scans, etc.).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="freitext" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Soweit im Antrag Freitextfelder vorgesehen sind, können sie mit diesem Element übermittelt werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="umfangBeantragteZulassung"
                        maxOccurs="unbounded"
                        type="erl:Code.Erlaubnisarten">
               <xs:annotation>
                  <xs:documentation>Angabe zur Erlaubnis, die beantragt wird.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="nachr:spezifischeInformation"
                        minOccurs="0"
                        maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>In diesem Datentyp kann ergänzend zu den Elementen der jeweiligen Nachricht eine spezifische ergänzende Information übermittelt werden. Die Verwendung dieses Elements ist nur nach bilateraler Abstimmung zwischen Autor und Leser zulässig.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="referenzierteSubjekte"
                        type="erl:ReferenzierteSubjekteMarktfestsetzung">
               <xs:annotation>
                  <xs:documentation>Innerhalb des Erlaubnisantrags über ID referenzierte Subjekte.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:bZRAuskunft" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zu einer Auskunft aus dem Bundeszentralregister zur Vorlage bei einer Behörde (Belegart O).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:gZRAuskunft" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zu einer Auskunft aus dem Gewerbezentralregister zur Vorlage bei einer Behörde (Belegart 9).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="antragsart" type="erl:Code.AntragsartMarktfestsetzung">
               <xs:annotation>
                  <xs:documentation>Angabe zur Art des Antrages (Festsetzung, Änderung, Aufhebung).</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:abweichendeAdresseGebuehrenbescheid" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Adresse im In- oder Ausland für einen Gebührenbescheid, welche von der Adresse des Antragstellenden abweicht.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:abweichendeAdresseGenehmigungsbescheid" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Adresse im In- oder Ausland für einen Genehmigungsbescheid, welche von der Adresse des Antragstellenden abweicht.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:angabenFinanzamt" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zum Finanzamt, falls es sich beim Antragsteller um ein Unternehmen handelt.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:veranstaltungsortMarktfestsetzung">
               <xs:annotation>
                  <xs:documentation>Angaben zum Veranstaltungsort im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="veranstaltungsform"
                        type="erl:Code.VeranstaltungsformMarktfestsetzung">
               <xs:annotation>
                  <xs:documentation>Angabe der Veranstaltungsform.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="bezeichnungVeranstaltung" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Bezeichnung der Veranstaltung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:zeitangabenMarktfestsetzung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Zeitangaben im Rahmen eines Erlaubnisantrages nach § 69 GewO.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:veranstaltungszweckMarktfestsetzung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zum Zweck der Veranstaltung im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:vertriebsartMarktfestsetzung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zur Vertriebsart der Waren und/oder Dienstleistungen im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:besucherkreisMarktfestsetzung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zum Besucherkreis der Veranstaltung im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:artWarenDienstleistungenMarktfestsetzung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zur Art der angebotenen Waren oder Dienstleistungen im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="wirtschaftsgebiet" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Wirtschaftsgebiet oder Wirtschaftszweig des Warenangebots.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="haelfteWirtschaftszweig" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Angabe, ob mindestens die Hälfte der Anbieter diesem Wirtschaftszweig zuzuordnen sind.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="anzahlAnbieter" minOccurs="0" type="xs:nonNegativeInteger">
               <xs:annotation>
                  <xs:documentation>Erwartete Zahl der Anbieter.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="minZwoelfAnbieterGewerblich" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Angabe, ob mindestens 12 Anbieter gewerblich tätig sind.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="artAngeboteneWaren"
                        minOccurs="0"
                        type="erl:Code.AngeboteneWarenMarktfestsetzung">
               <xs:annotation>
                  <xs:documentation>Angabe, welcher Art die angebotenen Waren sind.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="angeboteneWaren" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Angabe, welche Waren im Einzelnen angeboten werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="eintrittsgeld" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Angabe, ob ein Eintrittsgeld erhoben wird.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="hoeheEintrittsgeld"
                        minOccurs="0"
                        type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Höhe des erhobenen Eintrittsgeldes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="platzgeld" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Angabe, ob ein Platzgeld erhoben wird.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="hoehePlatzgeld" minOccurs="0" type="bdt:String.DIN91379.C">
               <xs:annotation>
                  <xs:documentation>Höhe des erhobenen Platzgeldes.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="erl:versicherungsschutz" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Angaben zu einem Versicherungsschutz.</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="gewo.mitteilung7.1610">
      <xs:annotation>
         <xs:documentation>Übermittlung einer Mitteilung nach §7 GewO durch einen Online-Dienst an eine zuständige Stelle.</xs:documentation>
      </xs:annotation>
