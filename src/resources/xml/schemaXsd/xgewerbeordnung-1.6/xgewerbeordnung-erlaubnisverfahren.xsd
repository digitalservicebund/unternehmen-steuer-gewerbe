               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="vertriebsartMarktfestsetzung">
      <xs:annotation>
         <xs:documentation>Angaben zur Vertriebsart der Waren und/oder Dienstleistungen im Rahmen der Marktfestsetzung nach § 69 GewO.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element name="muster" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Vertriebsart nach Muster.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="katalog" minOccurs="0" type="xs:boolean">
               <xs:annotation>
                  <xs:documentation>Vertriebsart nach Katalog.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element name="handverkauf" minOccurs="0" type="xs:boolean">
