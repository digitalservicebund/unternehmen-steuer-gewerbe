   <xs:import schemaLocation="xunternehmen-basismodul-wirtschaftlichetaetigkeit_1_2.xsd"
              namespace="urn:xoev-de:xunternehmen:standard:basismodul:wirtschaftlichetaetigkeit_1.2"/>
   <xs:element name="sonstigePersonenvereinigung">
      <xs:annotation>
         <xs:documentation>Das Kerndatenobjekt umfasst die allgemeinen Angaben zu einer sonstigen Personenvereinigung. Unter diesem Kerndatenobjekt werden alle Personenvereinigungen gefasst, die weder unter juristische Personen noch unter rechtsfähige Personengesellschaften fallen. Die sonstigen Personenvereinigungen (z. B. die Erbengemeinschaft) werden in der Regel nicht wirtschaftlich tätig. Die konkrete Rechtsform der sonstigen Personenvereinigung kann mittels einer Codeliste angegeben werden.</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:sequence>
            <xs:element ref="spv:sonstigePersonenvereinigung.id">
               <xs:annotation>
                  <xs:documentation>Innerhalb des jeweiligen Kontextes eindeutige ID dieser Instanz des Kerndatenobjekts Sonstige Personenvereinigung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="wt:bundeseinheitlicheWirtschaftsnummer" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Die bundeseinheitliche Wirtschaftsnummer für Unternehmen gemäß § 2 UBRegG.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="rf:rechtsform" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Die Rechtsform einer wirtschaftlichen Tätigkeit, einer juristischen Person, einer rechtsfähigen Personengesellschaft oder einer sonstigen Personenvereinigung im Sinne der Rechtsform-Codierung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="ename:eingetragenerName" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Die im Handels-, Genossenschafts- oder Gesellschaftsregister eingetragene Firma eines wirtschaftlich Tätigen oder einer wirtschaftlichen Tätigkeit (z. B. eingetragenes Einzelunternehmen, eingetragene Zweigniederlassung) bzw. der im Vereins-, Partnerschafts- oder Stiftungsregister oder im Stiftungsverzeichnis eingetragene Name. Der eingetragene Name kann auch in einem Register festgehalten sein, welches in einem anderen Staat geführt wird. Der eingetragene Name ist abzugrenzen von der Geschäftsbezeichnung.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="eintr:eintragung" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Dieses Kerndatenobjekt fasst die Daten, mit welchen die Eintragung eines wirtschaftlich Tätigen bzw. einer wirtschaftlichen Tätigkeit in einem Handels-, Genossenschafts-, Gesellschafts-, Vereins-, Partnerschafts- oder StiftungsregisterAb Inkrafttreten des Stiftungsregistergesetzes am 1. Januar 2026; die Erweiterung der Codelisten für die Eintragungsart und die Rechtsform erfolgt zeitnah nach Veröffentlichung dieser Spezifikation. sowie in einem Stiftungsverzeichnis identifiziert werden kann. Die Eintragung kann auch in ein Register oder Verzeichnis erfolgen, welches in einem anderen Staat geführt wird. Zwischen Rechtsform und Eintragung besteht ein Zusammenhang. Welche Eintragungsarten für welche Rechtsformen zulässig sind, wird als Information in der Codeliste der Rechtsformen mitgeführt.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="adr:anschrift" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben für die Adressierung. Eine Anschrift ist entweder eine Inlands- oder eine Auslandsanschrift.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="sitze:sitz" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Der Sitz einer Körperschaft, Personenvereinigung oder Vermögensmasse ist der Ort, der durch Gesetz, Gesellschaftsvertrag, Satzung, Stiftungsgeschäft oder dergleichen bestimmt ist.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="sitze:effektiverVerwaltungssitz" minOccurs="0">
               <xs:annotation>
                  <xs:documentation>Der effektiver Verwaltungssitz ist - im Unterschied zum Sitz - der Ort, an dem sich die Hauptverwaltung befindet und die Geschäfte tatsächlich geführt werden.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="kom:kommunikation" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angaben zu Telefon, Telefax, Email-Adresse oder Webseite.</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element ref="bspv:beteiligter.id" minOccurs="0" maxOccurs="unbounded">
               <xs:annotation>
                  <xs:documentation>Angabe eines Beteiligten einer sonstigen Personenvereinigung als ID-Querverweis innerhalb des jeweiligen Kontextes (Nachricht, Datensatz) auf ein Element np:natuerlichePerson (oder auf ein entsprechendes abgeleitetes Element).</xs:documentation>
               </xs:annotation>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   <xs:element name="sonstigePersonenvereinigung.id" type="bdt:IDType">
      <xs:annotation>
         <xs:documentation>Innerhalb des jeweiligen Kontextes eindeutige ID dieser Instanz des Kerndatenobjekts Sonstige Personenvereinigung.</xs:documentation>
      </xs:annotation>
   </xs:element>
</xs:schema>
