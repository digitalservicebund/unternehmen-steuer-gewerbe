                        </xs:enumeration>
                        <xs:enumeration value="S100">
                           <xs:annotation>
                              <xs:appinfo>
                                 <name>Nicht spezifikationskonform: Rückweisung aufgrund erneuter Lieferung eines bereits erfolgreich verarbeiteten Datensatzes</name>
